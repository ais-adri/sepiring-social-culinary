{
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "target": "es2022", "module": "esnext", "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"], "jsx": "preserve", "noEmit": true,
    "isolatedModules": true, "skipLibCheck": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "strictNullChecks": true, "noImplicitAny": true,
    "alwaysStrict": true, "types": ["node", "vite/client"], "paths": { "@/*": ["./src/*"] }
  }
}
